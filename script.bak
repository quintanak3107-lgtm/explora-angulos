const STORAGE_KEY='angleStarsV8';
const AWARDED_KEY='angleAwardedV8';
let stars=Number(localStorage.getItem(STORAGE_KEY)||0);
let awarded=JSON.parse(localStorage.getItem(AWARDED_KEY)||'[]');
const MAX_STARS=37;
const star=document.getElementById('stars');
function upd(){star.textContent=stars;localStorage.setItem(STORAGE_KEY,String(stars));}
function award(activity){
  if(awarded.includes(activity)) return false;
  awarded.push(activity);
  localStorage.setItem(AWARDED_KEY,JSON.stringify(awarded));
  if(stars<MAX_STARS){stars++;upd();}
  return true;
}
upd();
const routeOrder=['inicio','nodo2','nodo3','nodo4','nodo5','nodo6','nodo7','nodo8'];
const routeNames={inicio:'Inicio',nodo2:'¿Qué es un ángulo?',nodo3:'Tipos',nodo4:'Medición',nodo5:'Vida cotidiana',nodo6:'Figuras',nodo7:'Relaciones',nodo8:'Reto final'};
function showNode(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));const target=document.getElementById(id);if(!target)return;target.classList.add('active');scrollTo({top:0,behavior:'smooth'});}
document.addEventListener('click',e=>{const b=e.target.closest('[data-node]');if(b)showNode(b.dataset.node)});
document.addEventListener('click',e=>{const b=e.target.closest('.example-open');if(b){e.preventDefault();openExample(b.dataset.example)}});

function normalize(s){return String(s||'').trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');}
function feedbackSuccess(el,msg,activity){const got=activity?award(activity):false;el.textContent='🎉 '+msg+(activity?(got?' +1 estrella':' Esta actividad ya tenía su estrella.'):'');el.className='feedback game-success';return got;}
function feedbackRetry(el,msg){el.textContent='💡 '+msg;el.className='feedback game-error';}

// Actividades de respuesta libre: la corrección aparece solo después de comprobar.
document.querySelectorAll('.input-quiz').forEach(box=>{
  const input=box.querySelector('.answer-input'), btn=box.querySelector('.check-input'), feed=box.querySelector('.feedback');
  if(!input||!btn||!feed)return;
  const activity=box.dataset.activity;
  const expected=box.dataset.answer||'';
  function check(){
    const value=input.value;
    if(!value.trim()){feed.textContent='✏️ Escribí una respuesta antes de comprobar.';feed.className='feedback game-error';return;}
    let ok;
    if(input.type==='number') ok=Number(value)===Number(expected);
    else ok=normalize(value)==='vertice' || normalize(value)==='vértice';
    if(ok){input.disabled=true;btn.disabled=true;
      let msg='¡Correcto!';
      if(box.dataset.activity==='n4-calculo') msg='¡Correcto! 45° + 45° = 90°.';
      feedbackSuccess(feed,msg,activity);
    } else {
      feedbackRetry(feed,input.type==='number'?'Todavía no. Revisá el cálculo y probá nuevamente.':'Casi. El punto donde se unen los lados se llama vértice.');
    }
  }
  btn.addEventListener('click',check);
  input.addEventListener('keydown',e=>{if(e.key==='Enter')check()});
});

// Mini-juegos directos: una sola recompensa por actividad.
document.querySelectorAll('.quiz').forEach(q=>{
  const activity=q.dataset.activity||('quiz-'+q.closest('.screen')?.id);
  q.querySelectorAll('.opts button').forEach(b=>b.addEventListener('click',()=>{
    const f=q.querySelector('.feedback');
    if(normalize(b.textContent)===normalize(q.dataset.answer)){
      q.querySelectorAll('.opts button').forEach(x=>x.disabled=true);
      feedbackSuccess(f,'¡Correcto!',activity);
    }else feedbackRetry(f,'Todavía no. Volvé a comparar y probá otra opción.');
  }));
});

const qs=[
 ['Un ángulo mide 38°. ¿Cuánto le falta para llegar a 90°?',['42°','52°','62°','128°'],'52°','calc-1'],
 ['Un triángulo tiene ángulos de 70° y 45°. ¿Cuánto mide el tercero?',['55°','65°','75°','85°'],'65°','tri-1'],
 ['Un ángulo de 135° es...',['agudo','recto','obtuso','llano'],'obtuso','type-1'],
 ['Una vuelta completa mide...',['90°','180°','270°','360°'],'360°','turn-1'],
 ['Si un ángulo mide 25°, ¿cuánto mide su complementario?',['55°','65°','75°','155°'],'65°','comp-1'],
 ['Si un ángulo mide 120°, ¿cuánto mide su suplementario?',['50°','60°','70°','80°'],'60°','supp-1'],
 ['Para medir con precisión la amplitud de un ángulo usamos...',['regla','transportador','compás','escuadra'],'transportador','tool-1'],
 ['Dos rectas se cruzan. Si uno de los ángulos mide 72°, su opuesto por el vértice mide...',['18°','72°','108°','288°'],'72°','vert-1']
];
let i=0,score=0;
const q=document.getElementById('question'),opts=document.getElementById('gameopts'),feed=document.getElementById('gfeed'),next=document.getElementById('next'),bar=document.getElementById('bar'),qn=document.getElementById('qnum'),gs=document.getElementById('gscore'),res=document.getElementById('result'),again=document.getElementById('again');
function load(){const x=qs[i];qn.textContent=i+1;q.textContent=x[0];opts.innerHTML='';feed.textContent='';feed.className='feedback';next.classList.add('hidden');res.textContent='';bar.style.width=(i/8*100)+'%';x[1].forEach(o=>{const b=document.createElement('button');b.textContent=o;b.onclick=()=>{opts.querySelectorAll('button').forEach(z=>z.disabled=true);const ok=normalize(o)===normalize(x[2]);if(ok){score++;feedbackSuccess(feed,'¡Correcto!','n8-'+x[3]);gs.textContent=score;}else feedbackRetry(feed,'La respuesta correcta es '+x[2]+'.');next.classList.remove('hidden')};opts.appendChild(b)});}
next.onclick=()=>{i++;if(i<8)load();else{q.textContent='🏆 ¡Reto terminado!';opts.innerHTML='';feed.textContent='';bar.style.width='100%';res.innerHTML='Obtuviste <b>'+score+' de 8</b> respuestas correctas en este intento.<br><span class="small-note">Las estrellas solo se entregan una vez por desafío.</span>';next.classList.add('hidden');again.classList.remove('hidden')}};
again.onclick=()=>{i=0;score=0;gs.textContent=0;again.classList.add('hidden');load()};
load();

// El mini-juego de la explicación del cuadrilátero también tiene recompensa única.
document.querySelectorAll('.mini-game').forEach((game,index)=>{
  game.querySelectorAll('.angle-choice button').forEach(btn=>btn.addEventListener('click',()=>{
    const feedback=game.querySelector('.feedback');
    if(btn.dataset.correct==='yes'){game.querySelectorAll('.angle-choice button').forEach(b=>b.disabled=true);feedbackSuccess(feedback,'¡Correcto!','mini-'+index);}
    else feedbackRetry(feedback,'Todavía no. Volvé a comparar las medidas y probá nuevamente.');
  }));
});

const exampleData={
 'vertice':{title:'Encontrá el vértice',text:'El vértice es el punto donde se unen los dos lados. Mirá el dibujo y elegí el punto donde se encuentran.',formula:'Vértice = punto donde se unen los dos lados',visual:'angle-points',game:'point'},
 'lados':{title:'Encontrá los lados',text:'Un ángulo tiene dos lados: son las dos semirrectas que parten del vértice. Mirá el dibujo y contalos.',formula:'2 lados + 1 vértice = ángulo',visual:'two-rays',game:'count'},
 'llano-linea':{title:'Adiviná el ángulo de la línea',text:'Cuando los dos lados quedan enfrentados sobre una misma línea, forman un ángulo llano.',formula:'180°',visual:'straight',game:'angle180'},
 'llano-camino':{title:'¿Qué ángulo forman las dos direcciones?',text:'Imaginá que estás en un camino y mirás hacia adelante. Si te das vuelta y mirás exactamente hacia atrás, las dos direcciones están separadas por...',formula:'180°',visual:'road',game:'angle180'},
 'llano-transportador':{title:'Leé la base del transportador',text:'Si la base está alineada hacia la derecha, empezá a leer desde 0° a la derecha. La escala aumenta hacia la izquierda hasta 180°.',formula:'0° a la derecha → 180° a la izquierda',visual:'protractor',game:'angle180'},
 'medicion-reloj':{title:'Adiviná el ángulo del reloj',text:'Observá las agujas. A las 3:00, una apunta al 12 y otra al 3. ¿Qué ángulo forman?',formula:'3:00 → 90°',visual:'clock3',game:'angle90'},
 'medicion-puerta':{title:'¿Cuánto se abrió la puerta?',text:'La puerta se abre desde una posición cerrada. Mové el control y observá cómo cambia el ángulo.',formula:'La apertura se mide en grados',visual:'door',game:'door'},
 'vida-reloj':{title:'Detective del reloj',text:'Observá una hora al azar y decidí si el ángulo de las agujas es menor, igual o mayor que 90°. La medida exacta aparece después de responder.',formula:'',visual:'clock3',game:'clock'},
 'vida-tijeras':{title:'¿Qué pasa con las tijeras?',text:'Cuanto más abrimos las hojas, mayor es el ángulo. Elegí la situación que representa el ángulo más grande.',formula:'Más apertura = mayor ángulo',visual:'scissors',game:'scissors'},
 'vida-arquitectura':{title:'Detective de la arquitectura',text:'Buscá cuál de estos elementos tiene una esquina que representa un ángulo recto.',formula:'90°',visual:'architecture',game:'architecture'},
 'vida-deportes':{title:'La dirección del pase',text:'Un jugador cambia de dirección. Observá el giro y escribí cuántos grados mide el ángulo.',formula:'Un cuarto de vuelta = 90°',visual:'sport',game:'angle90'},
 'figura-triangulo':{title:'Completá el triángulo',text:'Dos ángulos miden 60° y 70°. ¿Cuánto debe medir el tercero para llegar a 180°?',formula:'60° + 70° + 50° = 180°',visual:'triangle',game:'triangle'},
 'figura-cuadrilatero':{title:'Construí los 360°',text:'Una diagonal divide un cuadrilátero en dos triángulos. Si cada uno suma 180°, ¿cuánto suman juntos?',formula:'180° + 180° = 360°',visual:'quadrilateral',game:'angle360'},
 'rel-complementarios':{title:'Completá el ángulo recto',text:'Un ángulo mide 35°. ¿Cuánto falta para llegar a 90°?',formula:'35° + 55° = 90°',visual:'complementary',game:'complement'},
 'rel-suplementarios':{title:'Completá el ángulo llano',text:'Un ángulo mide 110°. ¿Cuánto falta para llegar a 180°?',formula:'110° + 70° = 180°',visual:'supplementary',game:'supplement'},
 'rel-adyacentes':{title:'¿Son adyacentes?',text:'Los ángulos adyacentes comparten vértice y un lado. Elegí la figura que muestra esa relación.',formula:'Comparten vértice y un lado',visual:'adjacent',game:'adjacent'},
 'rel-opuestos':{title:'Descubrí los opuestos',text:'Cuando dos rectas se cruzan, los ángulos enfrentados tienen la misma medida. Elegí el par correcto.',formula:'Ángulos opuestos = misma medida',visual:'vertical',game:'opposite'}
};



